{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DemoDb": "Data Source=demo.db"
  },
  "Currency": {
    "BaseCurrency": "USD",
    "SupportedCurrencies": [ "EUR", "CAD", "GBP", "CHF" ]
  },
  "OpenExchangeRates": {
    "BaseUrl": "https://openexchangerates.org/api/",
    "AppId": "",
    "TimeoutSeconds": 10
  },
  "ExchangeRateSync": {
    "Cron": "0 6 * * 1",
    "SyncOnStartupWhenMissing": true
  }
}
